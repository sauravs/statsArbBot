// Prisma schema — statsArbBot
//
// Phase 0 ships a skeleton: the generator, datasource, the cross-cutting enums,
// and one stable append-only model so `prisma migrate` produces a real initial
// migration and the DB connectivity gate can be verified. Domain models
// (CointScanResult, ManualTrade, LiveSession/LiveTrade, Sim*, SavedFFSimulation,
// Strategy, OhlcvCache, …) are added field-by-field in their respective phases.

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (every domain model carries `exchange` so Phase-3 AI can JOIN) ──────

enum Exchange {
  dydx
  binance
  hyperliquid
}

enum TradingMode {
  forward_test // dYdX testnet
  simulation   // virtual account, mainnet prices
  production   // mainnet, real money
}

enum ManualTradeStatus {
  OPEN
  CLOSED
}

// Lifecycle of a live bot trade (Phase 5a).
enum LiveTradeStatus {
  PENDING // opening: leg placement in progress
  OPEN    // both legs filled and live on-exchange
  CLOSED  // both legs closed; realised P&L recorded
  ERROR   // open failed mid-flight; failsafe close attempted
}

// Lifecycle of a real-time simulation session (Phase 6).
enum SimSessionStatus {
  RUNNING // ticking on its APScheduler interval
  PAUSED  // registered but not ticking (resumable)
  STOPPED // ended; positions force-closed, no further ticks
}

// Status of a virtual simulation position (Phase 6).
enum SimPositionStatus {
  OPEN
  CLOSED
}

// Lifecycle of a fast-forward replay run (Phase 7).
enum FFSimStatus {
  RUNNING   // replay in progress (background task ticking through history)
  COMPLETED // replay reached the end of the window; aggregates saved
  STOPPED   // cancelled mid-run; partial aggregates saved
  FAILED    // replay aborted on an error
}

// Lifecycle of a walk-forward backtest run (Phase 8).
enum BacktestStatus {
  PENDING   // strategy created, never run
  RUNNING   // walk-forward in progress (background task sweeping windows)
  PAUSED    // paused at a window boundary; partial results saved, resumable
  COMPLETED // every window processed; results + report saved, rank assigned
  STOPPED   // stopped early (terminal); partial results saved
  FAILED    // backtest aborted on an error
}

// Backend strategy-campaign runner (Phase-3 WS3). A campaign expands a parameter
// grid into many Strategy rows and runs them with bounded concurrency; DB-backed so
// a restart resumes. This enum tracks the whole campaign; each member Strategy keeps
// its own BacktestStatus.
enum CampaignStatus {
  PENDING // created, not started
  RUNNING // execution queue draining the member strategies
  PAUSED  // execution paused; members mid-flight can resume
  DONE    // every member reached a terminal state
  STOPPED // stopped early by the operator (terminal)
}

// ── Config audit (append-only) ───────────────────────────────────────────────
// Stable seed model: records every bot-config change for auditing. Present from
// Phase 0 so migrations exist; extended as config surfaces grow.

model BotConfigHistory {
  id         String      @id @default(cuid())
  exchange   Exchange    @default(dydx)
  mode       TradingMode @default(forward_test)
  key        String
  value      String
  changed_at DateTime    @default(now())

  @@index([exchange, mode])
}

// ── Cointegration scan results (Phase 2) ─────────────────────────────────────
// One row per cointegrated pair found in a scan run. The CSV half of the
// dual-write (PRD §3.1 step 7) is for parity/inspection; this table is the
// authoritative store the pairs table reads from so results survive reload.
// Every row carries the same `scanned_at` for a given run so the latest scan is
// a single MAX(scanned_at) lookup per (exchange, mode).

model CointScanResult {
  id             String      @id @default(cuid())
  exchange       Exchange
  mode           TradingMode
  scanned_at     DateTime    @default(now()) @db.Timestamptz
  window_start   DateTime    @db.Timestamptz
  window_end     DateTime    @db.Timestamptz
  base_market    String
  quote_market   String
  hedge_ratio    Float
  intercept      Float       @default(0) // Option-B #1: spread includes α
  half_life      Float
  zero_crossings Int
  p_value        Float
  z_score        Float? // latest rolling Z-score of the spread at scan time
  spread_std     Float?

  @@index([exchange, mode, scanned_at])
  @@index([base_market, quote_market])
  @@map("coint_scan_results")
}

// ── Historical OHLCV cache (Phase 2.5) ───────────────────────────────────────
// Seeded by ingesting the existing dYdX history (data/dydx + data/dydx_extended)
// through the validation/cleaning pass (see ADR-0006). The cache holds only
// CLEAN candles — zero-volume, flat, and OHLC-inconsistent bars are dropped on
// ingest, and markets below the coverage threshold are excluded entirely; the
// full accounting lives in the ingest validation report. Phases 7 (fast-forward)
// and 8 (walk-forward backtest) replay from this table instead of re-fetching.

model OhlcvCache {
  id         String   @id @default(cuid())
  exchange   Exchange @default(dydx)
  market     String
  resolution String   @default("1HOUR")
  timestamp  DateTime @db.Timestamptz
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float

  @@unique([exchange, market, resolution, timestamp])
  @@index([exchange, market, resolution, timestamp])
  @@map("ohlcv_cache")
}

// ── Live Manual Trading (Phase 4, PRD F4) ────────────────────────────────────
// A trade the operator records by hand off a bot signal. Entry prices for both
// legs are captured server-side at record time (alongside the scan's β/α/half-
// life and the freshly-computed spread/z), so the per-leg P&L can be computed
// from user-supplied exit prices when the trade is later marked CLOSED. The PRD
// §5 field list is realised here (entry prices + exit prices + pnl added so F4.7
// P&L is actually computable — PRD §5 defers field-level schema to this phase).

model ManualTrade {
  id               String            @id @default(cuid())
  exchange         Exchange
  mode             TradingMode
  // Market-data source the trade was recorded under ("fake" demo vs "dydx"
  // live). Lets the dashboard separate demo trades from live ones (issue #43
  // follow-up) without deleting either. Defaults to the live source.
  data_source      String            @default("dydx")
  base_market      String
  quote_market     String
  hedge_ratio      Float
  half_life        Float // fresh OU half-life re-validated at record time (#147)
  p_value          Float? // fresh Engle-Granger p-value re-validated at entry (#147)
  z_score          Float // current rolling Z of the spread at record time
  spread_value     Float // current spread (S1 − β·S2 − α) at record time
  entry_price_leg1 Float // base close captured at record time (REFERENCE)
  entry_price_leg2 Float // quote close captured at record time (REFERENCE)
  capital_leg1_usd Float
  capital_leg2_usd Float
  recorded_at      DateTime          @default(now()) @db.Timestamptz
  status           ManualTradeStatus @default(OPEN)
  closed_at        DateTime?         @db.Timestamptz
  exit_price_leg1  Float? // operator's ACTUAL exit fill
  exit_price_leg2  Float? // operator's ACTUAL exit fill
  pnl              Float? // realised per-leg P&L sum, set on close

  // ── Realised-execution capture (slippage measurement) ────────────────────
  // The backtest charges a modelled `slippage_pct` per fill, but the true cost
  // of a market order is only knowable from real fills. Pairing an ACTUAL fill
  // with the REFERENCE price captured at the same instant makes realised
  // slippage computable per leg: entry → (fill_price − entry_price)/entry_price,
  // exit → (exit_price − exit_ref_price)/exit_ref_price, signed by leg side.
  // All nullable: rows recorded before this, and operators who skip the
  // optional entry-fill inputs, stay valid.
  fill_price_leg1     Float? // operator's ACTUAL entry fill, base leg
  fill_price_leg2     Float? // operator's ACTUAL entry fill, quote leg
  exit_ref_price_leg1 Float? // base REFERENCE captured server-side at close
  exit_ref_price_leg2 Float? // quote REFERENCE captured server-side at close

  @@index([exchange, mode, status])
  @@index([recorded_at])
  @@map("manual_trades")
}

// ── Live Trading (Phase 5a, PRD F5) ──────────────────────────────────────────
// DB-backed live-bot state (ADR-0003 — no flat bot_agents.json). A LiveSession is
// one activation of the bot for an (exchange, mode); its LiveTrades are the
// two-leg pairs it opened. Entry prices/sizes/sides are captured when both legs
// fill so real per-leg P&L is computable from exit prices on close. The exit
// manager reconciles OPEN rows against the exchange, so the DB is the source of
// truth a restart restores from (replacing the prototype's flat-file tracker).

model LiveSession {
  id         String      @id @default(cuid())
  exchange   Exchange
  mode       TradingMode
  active     Boolean     @default(true)
  started_at DateTime    @default(now()) @db.Timestamptz
  stopped_at DateTime?   @db.Timestamptz
  trades     LiveTrade[]

  @@index([exchange, mode, active])
  @@map("live_sessions")
}

model LiveTrade {
  id               String          @id @default(cuid())
  session_id       String
  session          LiveSession     @relation(fields: [session_id], references: [id])
  exchange         Exchange
  mode             TradingMode
  base_market      String
  quote_market     String
  base_side        String // BUY | SELL — action on the base leg at entry
  quote_side       String // BUY | SELL — action on the quote leg at entry
  base_size        Float // units of base held
  quote_size       Float // units of quote held
  hedge_ratio      Float
  half_life        Float
  entry_z_score    Float
  entry_price_leg1 Float // base fill price captured at open
  entry_price_leg2 Float // quote fill price captured at open
  status           LiveTradeStatus @default(PENDING)
  opened_at        DateTime        @default(now()) @db.Timestamptz
  exit_z_score     Float?
  exit_price_leg1  Float?
  exit_price_leg2  Float?
  exit_reason      String? // TAKE_PROFIT / STOP_LOSS_ZSCORE / STOP_LOSS_TIME (ExitReason) or RECONCILED / ORPHANED / ABORTED (reconciliation/abort)
  pnl              Float? // realised per-leg P&L sum, set on close
  closed_at        DateTime?       @db.Timestamptz
  error            String? // failure detail when status = ERROR

  @@index([exchange, mode, status])
  @@index([session_id])
  @@map("live_trades")
}

// ── Real-Time Simulation (Phase 6, PRD F6) ──────────────────────────────────
// DB-backed virtual trading (ADR-0003). A SimSession is a paper-trading account
// that ticks on an APScheduler interval (F6.4): each tick recomputes a *proper*
// rolling Z-score from live mainnet prices (F6.2 — fixes the prototype's 0.02-std
// approximation) via the same statcore path the live bot uses, then opens/closes
// virtual SimPositions on real signals, applying a slippage/fee/funding cost
// model (F6.3). The engine is stateless across ticks: every tick reloads open
// positions from the DB, so a session restored after an API restart resumes
// exactly where it left off (F6.1). Closed positions become SimTrade rows (the
// realised-P&L ledger that drives the equity curve).

model SimSession {
  id               String           @id @default(cuid())
  exchange         Exchange         @default(dydx)
  mode             TradingMode      @default(simulation)
  label            String? // optional user-provided name
  status           SimSessionStatus @default(RUNNING)
  starting_capital Float
  current_capital  Float // starting capital + realised net P&L − fees
  interval_seconds Int              @default(60) // tick cadence
  zscore_window    Int              @default(21)
  entry_threshold  Float            @default(1.5) // |Z| ≥ → open
  exit_threshold   Float            @default(0.5) // |Z| < → take-profit
  stop_threshold   Float            @default(4.0) // |Z| ≥ → stop-loss
  usd_per_trade    Float            @default(100) // notional per leg
  max_active_pairs Int? // cap on concurrent open pairs (null = no cap)
  slippage_pct     Float            @default(0.05) // per-leg, percent
  taker_fee_pct    Float            @default(0.05) // per-leg, percent
  funding_freq_h   Int              @default(1) // hours between funding accruals
  tick_count       Int              @default(0)
  last_tick_at     DateTime?        @db.Timestamptz
  created_at       DateTime         @default(now()) @db.Timestamptz
  stopped_at       DateTime?        @db.Timestamptz

  positions SimPosition[]
  trades    SimTrade[]

  @@index([exchange, mode, status])
  @@map("sim_sessions")
}

model SimPosition {
  id             String            @id @default(cuid())
  session_id     String
  session        SimSession        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  exchange       Exchange
  base_market    String
  quote_market   String
  direction      String // LONG_BASE | SHORT_BASE
  base_size      Float
  quote_size     Float
  hedge_ratio    Float
  half_life      Float // carried so the tick can apply the 3×half-life time-stop
  entry_z        Float
  entry_base_px  Float
  entry_quote_px Float
  entry_time     DateTime          @db.Timestamptz
  fee_cost       Float // entry fees (both legs)
  funding_pnl    Float             @default(0) // accrued funding so far
  status         SimPositionStatus @default(OPEN)

  @@index([session_id, status])
  @@map("sim_positions")
}

model SimTrade {
  id           String     @id @default(cuid())
  session_id   String
  session      SimSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  exchange     Exchange
  base_market  String
  quote_market String
  direction    String
  entry_time   DateTime   @db.Timestamptz
  exit_time    DateTime   @db.Timestamptz
  hold_hours   Float
  entry_z      Float
  exit_z       Float?
  // Per-leg fill prices at entry/exit — the "spot" of each trade. Nullable so
  // rows written before this was recorded (issue #162) stay valid.
  entry_base_px  Float?
  entry_quote_px Float?
  exit_base_px   Float?
  exit_quote_px  Float?
  exit_reason  String // TAKE_PROFIT | STOP_LOSS_ZSCORE | STOP_LOSS_TIME | STOPPED
  notional_usd Float
  gross_pnl    Float
  fee_cost     Float // entry + exit fees
  funding_pnl  Float
  net_pnl      Float // gross − fees + funding

  @@index([session_id])
  @@index([exchange, entry_time])
  @@map("sim_trades")
}

// ── Fast-Forward Simulation (Phase 7, PRD F7) ───────────────────────────────
// A completed (or in-progress) historical replay. The FastForwardReplayEngine
// drives the SAME stateless tick core as the real-time sim (simulation.run_tick)
// but feeds it PairTick snapshots built from OhlcvCache slices at a moving cursor
// over [start_time, end_time] instead of live prices, accruing funding from
// FundingRateCache. The intermediate positions/trades live in an in-memory ledger
// during the run; only the saved aggregates land here (F7.2): the equity curve,
// per-pair P&L, and exit-reason histogram, plus the run parameters and progress.
// One row IS the replay — list/detail read it directly, so a finished run renders
// without recomputation.

model SavedFFSimulation {
  id               String      @id @default(cuid())
  exchange         Exchange    @default(dydx)
  label            String?
  status           FFSimStatus @default(RUNNING)
  // Replay window + nominal playback speed (informational — the batch runs at
  // full compute speed; speed labels the intended N× playback for the UI).
  start_time       DateTime    @db.Timestamptz
  end_time         DateTime    @db.Timestamptz
  speed            Int         @default(3600)
  // Run parameters (mirror the SimSession knobs — one source of signal/cost truth).
  zscore_window    Int         @default(21)
  entry_threshold  Float       @default(1.5)
  exit_threshold   Float       @default(0.5)
  stop_threshold   Float       @default(4.0)
  usd_per_trade    Float       @default(100)
  max_active_pairs Int?
  slippage_pct     Float       @default(0.05)
  taker_fee_pct    Float       @default(0.05)
  funding_freq_h   Int         @default(1)
  // Progress + results.
  pairs_count      Int         @default(0)
  total_ticks      Int         @default(0)
  processed_ticks  Int         @default(0)
  progress         Float       @default(0) // 0..1
  starting_capital Float
  final_capital    Float? // null until COMPLETED/STOPPED
  realised_pnl     Float? // Σ closed-trade net_pnl
  total_trades     Int         @default(0)
  equity_curve     Json? // [{t: unix_seconds, equity: float}, …] (downsampled)
  per_pair_pnl     Json? // {"BASE/QUOTE": {net_pnl, trades, wins}, …}
  exit_reasons     Json? // {"TAKE_PROFIT": n, "STOP_LOSS_ZSCORE": n, …}
  error            String?
  created_at       DateTime    @default(now()) @db.Timestamptz
  completed_at     DateTime?   @db.Timestamptz

  @@index([exchange, status])
  @@index([created_at])
  @@map("saved_ff_simulations")
}

// Historical funding rates, ingested alongside OHLCV so the simulation/backtest
// cost model can charge real carry (dYdX funds hourly). No OHLC cleaning applies
// (single rate per timestamp); rows are de-duplicated and sorted on ingest.

model FundingRateCache {
  id           String   @id @default(cuid())
  exchange     Exchange @default(dydx)
  market       String
  timestamp    DateTime @db.Timestamptz
  funding_rate Float

  @@unique([exchange, market, timestamp])
  @@index([exchange, market, timestamp])
  @@map("funding_rate_cache")
}

// ── Walk-Forward Backtest (Phase 8, PRD F8) ─────────────────────────────────
// A Strategy is a parameter set (the varied Z-threshold / window of S1–S4, plus
// the cost model and walk-forward window lengths). Running its backtest sweeps
// sliding scan/trade windows over the historical cache: in each window it re-runs
// the SAME statcore cointegration scan over [scan_start, scan_end] to select pairs,
// then trades them over the following [trade_start, trade_end] through the SAME
// stateless tick core (simulation.run_tick) the live bot / sim / fast-forward use —
// carrying capital forward and force-closing at each boundary (the next window may
// pick different pairs). One row IS the strategy AND its latest result: progress +
// resume cursor (processed_windows / current_capital), the saved aggregates (equity
// curve, per-window summary, per-pair P&L, exit-reason histogram), the generated
// markdown report, and the cross-strategy rank by net P&L. Partial results are
// persisted at every window boundary so a PAUSED/STOPPED run resumes from the next
// unprocessed window (F8.2).

model Strategy {
  id          String         @id @default(cuid())
  exchange    Exchange       @default(dydx)
  // Market-data source the strategy was created/run under ("fake" demo vs "dydx"
  // live). Scopes the list so demo strategies stay in demo and live in live
  // (issue #98) — same pattern as ManualTrade.data_source. Defaults to live.
  data_source String         @default("dydx")
  name        String // S1..S4 or a user-given label
  description String?
  status      BacktestStatus @default(PENDING)

  // Provenance axis (Phase-2 Slice 6): which project phase created this run.
  // 1 = phase-1 baseline (the 69 saved configs); 2 = phase-2 (sub-phase B onward —
  // carries the honest per-market cost model when the flags are on). Additive column,
  // backfilled to 1; NEVER used to hide phase-1 rows. Orthogonal to the cost/span/
  // family axes (docs/PHASE2_STRATEGY_PLAN.md §7 Slice 6).
  phase Int @default(1)

  // Campaign membership (Phase-3 WS3). Set when a strategy was created by a campaign
  // grid expansion; null for hand-created runs. Additive + nullable; ON DELETE SET
  // NULL so deleting a campaign never deletes its member strategies (the runs are the
  // evidence — they outlive the campaign).
  campaign_id String?
  campaign    Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  // Walk-forward window lengths (PRD F8.1 default 90d scan / 30d trade; configurable
  // so the offline demo can use short windows over the synthetic history).
  scan_window_days  Int @default(90)
  trade_window_days Int @default(30)

  // Signal parameters — the knobs S1–S4 vary.
  zscore_window   Int   @default(21)
  entry_threshold Float @default(1.5)
  exit_threshold  Float @default(0.5)
  stop_threshold  Float @default(4.0)
  pvalue_max      Float @default(0.05)
  max_half_life_h Float @default(72)

  // Historical span to walk (optional offline: defaults to the demo window).
  start_time DateTime? @db.Timestamptz
  end_time   DateTime? @db.Timestamptz

  // Backtest universe liquidity/spread filter (Phase-3 WS1, path b) — PER-STRATEGY.
  // Optional; null = OFF (fall back to the global env default, which is also OFF).
  // When set, the walk-forward prunes its market universe BEFORE the scan (drop
  // markets below the $/hr floor and/or above the half-spread % ceiling), reusing
  // simulation.spread_cost.filter_universe. Persisted with the run so its universe
  // is reproducible. HONESTY/robustness knob, NOT alpha — filtering up LOSES money
  // (the gross lives in the thinnest markets; PHASE2_STRATEGY_PLAN §4). Supersedes
  // the process-global BACKTEST_MIN_DOLLAR_VOLUME / BACKTEST_MAX_HALF_SPREAD_PCT.
  backtest_min_dollar_volume   Float? // $/hr floor; null/0 = off
  backtest_max_half_spread_pct Float? // percent ceiling; null/0 = off

  // Cost model (mirrors the SimSession / SavedFFSimulation knobs).
  starting_capital Float @default(10000)
  usd_per_trade    Float @default(100)
  max_active_pairs Int?
  slippage_pct     Float @default(0.05)
  taker_fee_pct    Float @default(0.05)
  funding_freq_h   Int   @default(1)

  // Progress + resume state.
  total_windows     Int    @default(0)
  processed_windows Int    @default(0) // resume cursor
  progress          Float  @default(0) // 0..1
  current_capital   Float? // carried capital between windows (null ⇒ use starting)

  // Results.
  final_capital Float?
  net_pnl       Float? // Σ closed-trade net_pnl across all windows
  total_trades  Int     @default(0)
  win_rate      Float? // fraction of trades with net_pnl > 0
  rank          Int? // 1 = best net_pnl among COMPLETED strategies
  equity_curve  Json? // [{t: unix_seconds, equity: float}, …] (downsampled)
  per_window    Json? // [{index, scan_start, scan_end, trade_start, trade_end, pairs, trades, net_pnl}]
  per_pair_pnl  Json? // {"BASE/QUOTE": {net_pnl, trades, wins}, …}
  exit_reasons  Json? // {"TAKE_PROFIT": n, …}
  report_md     String? // generated markdown report (F8.3)
  error         String?

  // Per-trade blotter — each closed trade across all windows (issue #162). The
  // engine discarded these before; persisting them lets the UI drill into a
  // window and see where/when each trade entered/exited and why.
  trades BacktestTrade[]

  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  completed_at DateTime? @db.Timestamptz

  @@index([exchange, data_source, status])
  @@index([rank])
  @@index([campaign_id])
  @@map("strategies")
}

// Backend strategy-campaign runner (Phase-3 WS3). Expands a parameter grid (the
// `spec`) into many member Strategy rows and drives them through a bounded-concurrency
// execution queue; DB-backed so a restart resumes (mirrors the sweep's
// processed_windows pattern). Progress counters are cheap, queryable status without
// scanning every member. Deleting a campaign SET NULLs its members' campaign_id — the
// runs (the evidence) are never deleted with it.
model Campaign {
  id          String         @id @default(cuid())
  name        String
  // Scope like Strategy: which venue + market-data source the campaign runs under.
  exchange    Exchange       @default(dydx)
  data_source String         @default("dydx")
  status      CampaignStatus @default(PENDING)
  // The posted grid spec (windows × axes × base + cost flags), stored verbatim so a
  // campaign is reproducible and the expansion is auditable.
  spec        Json
  // Max member strategies running at once (2-vCPU prod → keep small; configurable).
  concurrency Int            @default(2)
  // Progress counters (denormalised for cheap status): total members, terminal
  // successes, terminal failures. running/pending are derived (total − completed − failed).
  total       Int            @default(0)
  completed   Int            @default(0)
  failed      Int            @default(0)

  strategies Strategy[]

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  started_at DateTime? @db.Timestamptz
  ended_at   DateTime? @db.Timestamptz

  @@index([status])
  @@map("campaigns")
}

// One closed trade from a walk-forward backtest (issue #162). The engine replays
// each test window through the shared ``run_tick`` core producing full trade
// records; before, only aggregates were kept. Persisting each trade — stamped
// with the ``window_index`` it belongs to — powers the per-window trade blotter
// (where/when each trade entered & exited on the spread, and the exit rationale).
// Cascades with its Strategy so deleting a strategy removes its trades.
model BacktestTrade {
  id           String   @id @default(cuid())
  strategy_id  String
  strategy     Strategy @relation(fields: [strategy_id], references: [id], onDelete: Cascade)
  window_index Int // which walk-forward window produced this trade
  exchange     Exchange
  base_market  String
  quote_market String
  direction    String
  entry_time   DateTime @db.Timestamptz
  exit_time    DateTime @db.Timestamptz
  hold_hours   Float
  entry_z      Float
  exit_z       Float?
  // Per-leg fill prices — the entry/exit "spot" of each leg.
  entry_base_px  Float?
  entry_quote_px Float?
  exit_base_px   Float?
  exit_quote_px  Float?
  // The pair's cointegration params for THIS trade's formation window (issue #166),
  // so a per-trade chart can reproduce the exact spread/z the backtest traded on
  // (spread = base − β·quote − α). Nullable: trades recorded before this stay valid.
  hedge_ratio  Float?
  intercept    Float?
  half_life    Float?
  exit_reason  String // TAKE_PROFIT | STOP_LOSS_ZSCORE | STOP_LOSS_TIME | STOPPED | END_OF_WINDOW
  notional_usd Float
  gross_pnl    Float
  fee_cost     Float // entry + exit fees
  funding_pnl  Float
  net_pnl      Float // gross − fees + funding

  @@index([strategy_id, window_index])
  @@map("backtest_trades")
}
