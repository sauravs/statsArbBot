// Prisma schema — statsArbBot
//
// Phase 0 ships a skeleton: the generator, datasource, the cross-cutting enums,
// and one stable append-only model so `prisma migrate` produces a real initial
// migration and the DB connectivity gate can be verified. Domain models
// (CointScanResult, ManualTrade, LiveSession/LiveTrade, Sim*, SavedFFSimulation,
// Strategy, OhlcvCache, …) are added field-by-field in their respective phases.

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (every domain model carries `exchange` so Phase-3 AI can JOIN) ──────

enum Exchange {
  dydx
  binance
  hyperliquid
}

enum TradingMode {
  forward_test // dYdX testnet
  simulation   // virtual account, mainnet prices
  production   // mainnet, real money
}

enum ManualTradeStatus {
  OPEN
  CLOSED
}

// ── Config audit (append-only) ───────────────────────────────────────────────
// Stable seed model: records every bot-config change for auditing. Present from
// Phase 0 so migrations exist; extended as config surfaces grow.

model BotConfigHistory {
  id         String      @id @default(cuid())
  exchange   Exchange    @default(dydx)
  mode       TradingMode @default(forward_test)
  key        String
  value      String
  changed_at DateTime    @default(now())

  @@index([exchange, mode])
}

// ── Cointegration scan results (Phase 2) ─────────────────────────────────────
// One row per cointegrated pair found in a scan run. The CSV half of the
// dual-write (PRD §3.1 step 7) is for parity/inspection; this table is the
// authoritative store the pairs table reads from so results survive reload.
// Every row carries the same `scanned_at` for a given run so the latest scan is
// a single MAX(scanned_at) lookup per (exchange, mode).

model CointScanResult {
  id             String      @id @default(cuid())
  exchange       Exchange
  mode           TradingMode
  scanned_at     DateTime    @default(now()) @db.Timestamptz
  window_start   DateTime    @db.Timestamptz
  window_end     DateTime    @db.Timestamptz
  base_market    String
  quote_market   String
  hedge_ratio    Float
  intercept      Float       @default(0) // Option-B #1: spread includes α
  half_life      Float
  zero_crossings Int
  p_value        Float
  z_score        Float? // latest rolling Z-score of the spread at scan time
  spread_std     Float?

  @@index([exchange, mode, scanned_at])
  @@index([base_market, quote_market])
  @@map("coint_scan_results")
}

// ── Historical OHLCV cache (Phase 2.5) ───────────────────────────────────────
// Seeded by ingesting the existing dYdX history (data/dydx + data/dydx_extended)
// through the validation/cleaning pass (see ADR-0006). The cache holds only
// CLEAN candles — zero-volume, flat, and OHLC-inconsistent bars are dropped on
// ingest, and markets below the coverage threshold are excluded entirely; the
// full accounting lives in the ingest validation report. Phases 7 (fast-forward)
// and 8 (walk-forward backtest) replay from this table instead of re-fetching.

model OhlcvCache {
  id         String   @id @default(cuid())
  exchange   Exchange @default(dydx)
  market     String
  resolution String   @default("1HOUR")
  timestamp  DateTime @db.Timestamptz
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float

  @@unique([exchange, market, resolution, timestamp])
  @@index([exchange, market, resolution, timestamp])
  @@map("ohlcv_cache")
}

// ── Live Manual Trading (Phase 4, PRD F4) ────────────────────────────────────
// A trade the operator records by hand off a bot signal. Entry prices for both
// legs are captured server-side at record time (alongside the scan's β/α/half-
// life and the freshly-computed spread/z), so the per-leg P&L can be computed
// from user-supplied exit prices when the trade is later marked CLOSED. The PRD
// §5 field list is realised here (entry prices + exit prices + pnl added so F4.7
// P&L is actually computable — PRD §5 defers field-level schema to this phase).

model ManualTrade {
  id               String            @id @default(cuid())
  exchange         Exchange
  mode             TradingMode
  base_market      String
  quote_market     String
  hedge_ratio      Float
  half_life        Float
  z_score          Float // current rolling Z of the spread at record time
  spread_value     Float // current spread (S1 − β·S2 − α) at record time
  entry_price_leg1 Float // base close captured at record time
  entry_price_leg2 Float // quote close captured at record time
  capital_leg1_usd Float
  capital_leg2_usd Float
  recorded_at      DateTime          @default(now()) @db.Timestamptz
  status           ManualTradeStatus @default(OPEN)
  closed_at        DateTime?         @db.Timestamptz
  exit_price_leg1  Float?
  exit_price_leg2  Float?
  pnl              Float? // realised per-leg P&L sum, set on close

  @@index([exchange, mode, status])
  @@index([recorded_at])
  @@map("manual_trades")
}

// Historical funding rates, ingested alongside OHLCV so the simulation/backtest
// cost model can charge real carry (dYdX funds hourly). No OHLC cleaning applies
// (single rate per timestamp); rows are de-duplicated and sorted on ingest.

model FundingRateCache {
  id           String   @id @default(cuid())
  exchange     Exchange @default(dydx)
  market       String
  timestamp    DateTime @db.Timestamptz
  funding_rate Float

  @@unique([exchange, market, timestamp])
  @@index([exchange, market, timestamp])
  @@map("funding_rate_cache")
}
