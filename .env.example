# ── dYdX credentials ──────────────────────────────────────────────────────────
DYDX_WALLET_API_KEY=dydx1your_wallet_address_here
DYDX_PRIVATE_KEY=0xyour_private_key_here

# Testnet (forward_test) or mainnet (production / simulation)
ENVIRONMENT=testnet

# ── Dashboard ─────────────────────────────────────────────────────────────────
# 6-digit passcode for the login screen.
DASHBOARD_PASSWORD=changeme
# Secret used to sign session JWTs (Next.js auth). Use a long random string.
DASHBOARD_JWT_SECRET=change-me-to-a-long-random-string
API_URL=http://localhost:8000

# ── Database (Phase 2) ────────────────────────────────────────────────────────
# Docker Compose sets this automatically using POSTGRES_PASSWORD below.
# For local dev without Docker, set this manually:
DATABASE_URL=postgresql://statsarb:yourpassword@localhost:5432/statsarb

# Docker Compose only — Postgres password for the container
POSTGRES_PASSWORD=yourpassword

# ── Cointegration scan (Phase 2) ──────────────────────────────────────────────
# Data source for the scan: "dydx" hits the live mainnet indexer; "fake" uses a
# deterministic in-process demo dataset (offline dev, demos, and E2E tests).
SCAN_DATA_SOURCE=dydx
# Pages of hourly candle history per market (full scan) and quick scan.
NUM_HISTORICAL_PAGES=4
SCAN_QUICK_PAGES=2
# Max simultaneous candle-fetch requests against the indexer.
SCAN_FETCH_CONCURRENCY=3
# Exclude markets with 24h volume below this (USD). Phase-2 default: $1M/day
# (~48 HL markets / ~1,130 candidate pairs) keeps the manual scan-review list
# tractable and fillable. Tractability, NOT alpha — see docs/PHASE2_STRATEGY_PLAN.md §5.
MIN_LIQUIDITY_USD=1000000

# Per-market realistic cost model (Phase-2 Slice 1). OFF → the backtest charges the
# flat per-strategy slippage_pct. ON → each leg is charged its market's half-spread
# (seed override table → volume→spread curve → measured-mean default;
# backend/simulation/spread_cost.py). Honest cost, NOT alpha. Only affects the
# walk-forward backtest; real-time sim/FF keep the flat cost. Default OFF.
PER_MARKET_SLIPPAGE=false

# ── Live trading execution (Phase 5a) ─────────────────────────────────────────
# dYdX subaccount used for order placement / account queries (0 = default).
DYDX_SUBACCOUNT_INDEX=0
# Mainnet gRPC node (used only when ENVIRONMENT=mainnet; testnet uses the SDK default).
DYDX_MAINNET_NODE_URL=dydx-ops-grpc.kingnodes.com:443
# Market-order execution params (5% price buffer, short-term order expiry, fill polling).
ORDER_PRICE_BUFFER=0.05
ORDER_EXPIRY_BLOCKS=10
MAX_ORDER_WAIT_SECS=20
ORDER_POLL_INTERVAL=3

# ── Simulation defaults (Phase 2) ─────────────────────────────────────────────
SIM_DEFAULT_CAPITAL=10000
SIM_DEFAULT_INTERVAL_S=300

# ── Telegram approval / alerts (Phase 9 — ADR-0009) ──────────────────────────
# Set BOTH a bot token and the operator chat id to enable the live human-in-the-
# loop approval gate + CODE-RED alerts. Leave either as its placeholder (or unset)
# to keep the auto-approve gate + logging alerter (every non-live phase uses that).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Minutes to wait for an approve/reject tap before auto-rejecting the signal
# (0 = reject immediately, a kill-switch).
TELEGRAM_APPROVAL_TIMEOUT_MIN=15
